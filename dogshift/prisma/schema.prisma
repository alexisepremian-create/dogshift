generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String?
  image                  String?
  role                   Role                    @default(OWNER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  emailVerified          DateTime?
  sitterId               String?                 @unique
  passwordHash           String?
  hostProfileJson        String?
  clerkUserId            String?                 @unique
  phone                  String?                 @db.VarChar(20)
  accounts               Account[]
  availabilities         Availability[]          @relation("SitterAvailabilities")
  availabilityExceptions AvailabilityException[]
  availabilityRules      AvailabilityRule[]
  sitterBookings         Booking[]               @relation("SitterBookings")
  bookings               Booking[]               @relation("UserBookings")
  ownerConversations     Conversation[]          @relation("OwnerConversations")
  sitterConversations    Conversation[]          @relation("SitterConversations")
  dogProfiles            DogProfile[]
  sentMessages           Message[]
  notifications          Notification[]
  reviewsWritten         Review[]                @relation("ReviewOwner")
  reviewsReceived        Review[]                @relation("ReviewSitter")
  serviceConfigs         ServiceConfig[]
  sessions               Session[]
  sitterApplications     SitterApplication[]
  sitterProfile          SitterProfile?
  pushSubscriptions      PushSubscription[]
  nativePushTokens       NativePushToken[]
  adoptionListings       AdoptionListing[]       @relation("AdoptionListingAuthor")
  adopterProfile         AdopterProfile?
  adoptionApplications   AdoptionApplication[]   @relation("AdoptionApplicant")
  adoptionMessagesSent   AdoptionMessage[]       @relation("AdoptionMessagesSent")
  adoptionSavedSearches  AdoptionSavedSearch[]
  rescueOrganization     RescueOrganization?
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  title          String
  body           String?
  entityId       String?
  url            String?
  metadata       Json?
  idempotencyKey String
  createdAt      DateTime         @default(now())
  readAt         DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model InviteCode {
  id        String         @id @default(cuid())
  code      String         @unique
  type      InviteCodeType
  usedAt    DateTime?
  expiresAt DateTime?
  note      String?
  createdAt DateTime       @default(now())
}

model SitterApplication {
  id        String   @id @default(cuid())
  userId    String
  data      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PilotSitterApplication {
  id                        String                  @id @default(cuid())
  firstName                 String
  lastName                  String
  city                      String
  email                     String
  phone                     String
  age                       Int?
  experienceText            String
  hasDogExperience          Boolean
  motivationText            String
  availabilityText          String
  consentInterview          Boolean
  consentPrivacy            Boolean
  status                    SitterApplicationStatus @default(PENDING)
  utmSource                 String?
  utmMedium                 String?
  utmCampaign               String?
  utmContent                String?
  utmTerm                   String?
  referrer                  String?
  userAgent                 String?
  ip                        String?
  idempotencyKey            String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  npa                       String?
  cityOther                 String?
  linkAnimalProfession      String?
  linkAnimalProfessionOther String?
  gardeExperienceLevel      String?
  availabilityStructured    Json?
  gardeTypes                String[]                @default([])
  dogSizes                  String[]                @default([])
  housingType               String?
  housingTypeOther          String?
  otherAnimals              Json?
  otherAnimalsDogCount      Int?
  hasCarLicense             Boolean?
  allergies                 String?
  calendlyLink              String?
  acceptedEmailSentAt       DateTime?
  acceptedEmailSource       String?
  /// Postal address (rue + numéro, e.g. "Rue du Lac 35"). Combined with city + npa
  /// at display time. Required by the new sitter form so we can compute travel
  /// fees and ship the contract PDF — nullable in schema for backward compat
  /// with applications submitted before this field existed.
  address                   String?

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([city, status])
}

model AdminNote {
  id                String              @id @default(cuid())
  targetType        AdminNoteTargetType
  targetId          String
  body              String
  authorClerkUserId String?
  authorUserId      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([targetType, targetId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([authorClerkUserId, createdAt])
}

model SitterProfile {
  id                           String                              @id @default(cuid())
  userId                       String                              @unique
  sitterId                     String                              @unique
  published                    Boolean                             @default(false)
  publishedAt                  DateTime?
  displayName                  String?
  city                         String?
  postalCode                   String?
  bio                          String?
  avatarUrl                    String?
  lat                          Float?
  lng                          Float?
  services                     Json?
  pricing                      Json?
  dogSizes                     Json?
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt
  termsAcceptedAt              DateTime?
  termsVersion                 String?
  profileCompletion            Int                                 @default(0)
  idDocumentUrl                String?
  selfieUrl                    String?
  verificationNotes            String?
  verificationReviewedAt       DateTime?
  verificationStatus           VerificationStatus                  @default(not_verified)
  verificationSubmittedAt      DateTime?
  stripeAccountId              String?
  stripeAccountStatus          String?
  stripeOnboardingCompletedAt  DateTime?
  lifecycleStatus              SitterLifecycleStatus               @default(application_received)
  contractVersion              String?
  contractAcceptedAt           DateTime?
  contractSignerName           String?
  contractSignedAt             DateTime?
  contractSignatureValue       String?
  contractSnapshot             Json?
  activationCodeHash           String?                             @unique
  activationCodeIssuedAt       DateTime?
  activationCodeUsedAt         DateTime?
  activatedAt                  DateTime?
  contractAccessTokenHash      String?
  contractAccessTokenIssuedAt  DateTime?
  contractAccessTokenExpiresAt DateTime?
  contractAccessTokenUsedAt    DateTime?
  lastMinuteEnabled            Boolean                             @default(false)
  contractAccessTokenVersion   String?
  contractSignedPdfUrl         String?
  activationCodeExpiresAt      DateTime?
  address                      String?
  /// @deprecated — kept for backward compat during migration. Use capacityPlaces + accepts* instead.
  maxDogsBySize                Json?
  /// Pension home photo verification
  /// Status: not_submitted | pending | ai_reviewing | ai_approved | ai_rejected | approved | rejected | legacy_pending
  pensionVerifStatus           String                              @default("not_submitted")
  pensionPhotoUrls             Json?
  pensionPhotoSubmittedAt      DateTime?
  pensionPhotoReviewedAt       DateTime?
  pensionAiScore               Float?
  pensionAiVerdict             String?
  pensionAiReasoning           Json?
  pensionAiReviewedAt          DateTime?
  pensionAdminNotes            String?
  /// Accepted dog sizes for Pension: ["Petit", "Moyen", "Grand"] — set by admin at approval time
  pensionAcceptedSizes         Json?
  /// Inactivity tracking for published sitters with no availability
  /// Status: null (ok) | "nudge_sent" | "warning_1" | "warning_2" | "suspended"
  inactivityStatus             String?
  /// When the first "add availability" email was sent
  inactivityNudgeAt            DateTime?
  /// When warning 1 was sent (4-5 days after nudge)
  inactivityWarning1At         DateTime?
  /// When warning 2 was sent (3-4 days after warning 1)
  inactivityWarning2At         DateTime?
  /// When the account was suspended
  inactivitySuspendedAt        DateTime?
  /// @deprecated — kept for backward compat during migration. Use neuteredRequired instead.
  acceptanceCriteria           Json?
  /// OPAn art.101 certificate for sitters accepting >5 dogs simultaneously
  /// Status: null | "not_submitted" | "pending" | "approved" | "rejected"
  maxDogsCertVerifStatus       String?
  /// R2 key of the uploaded document (FSIFP attestation or cantonal authorization)
  maxDogsCertPhotoKey          String?
  maxDogsCertSubmittedAt       DateTime?
  maxDogsCertReviewedAt        DateTime?
  maxDogsCertAdminNotes        String?
  /// Weighted-places capacity model (replaces old per-size counters)
  /// Total capacity in "places" (small=1, medium=2, large=3). Range: 1–15.
  capacityPlaces               Int                                 @default(3)
  acceptsSmall                 Boolean                             @default(true)
  acceptsMedium                Boolean                             @default(true)
  acceptsLarge                 Boolean                             @default(true)
  /// Require neutered/spayed dogs
  neuteredRequired             Boolean                             @default(false)
  contractAmendmentAcceptances SitterContractAmendmentAcceptance[]
  user                         User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationAccessLogs       VerificationAccessLog[]

  @@index([published])
  @@index([city])
  @@index([postalCode])
  @@index([verificationStatus])
  @@index([pensionVerifStatus])
}

model VerificationAccessLog {
  id               String        @id @default(cuid())
  sitterProfileId  String
  sitterId         String
  action           String
  fileKey          String?
  adminClerkUserId String?
  userAgent        String?
  createdAt        DateTime      @default(now())
  sitterProfile    SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)

  @@index([sitterProfileId, createdAt])
  @@index([sitterId, createdAt])
}

model ContractAmendment {
  id          String                              @id @default(cuid())
  title       String
  content     String
  version     String                              @unique
  isActive    Boolean                             @default(false)
  activatedAt DateTime?
  createdAt   DateTime                            @default(now())
  updatedAt   DateTime                            @updatedAt
  status      ContractAmendmentStatus             @default(INACTIVE)
  acceptances SitterContractAmendmentAcceptance[]

  @@index([status, createdAt])
  @@index([isActive, createdAt])
  @@index([createdAt])
}

model ServiceCost {
  id                      String                 @id @default(cuid())
  name                    String
  type                    ServiceCostType
  costType                ServiceCostBillingType
  monthlyCost             Float
  notes                   String?
  active                  Boolean                @default(true)
  estimatedCostPerBooking Float?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([active, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model SitterContractAmendmentAcceptance {
  id               String            @id @default(cuid())
  amendmentId      String
  sitterProfileId  String
  amendmentVersion String
  amendmentTitle   String
  amendmentContent String
  acceptedAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  amendment        ContractAmendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  sitterProfile    SitterProfile     @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)

  @@unique([amendmentId, sitterProfileId])
  @@index([sitterProfileId, acceptedAt])
  @@index([amendmentId, acceptedAt])
}

model Booking {
  id                         String                @id @default(cuid())
  userId                     String
  sitterId                   String
  status                     BookingStatus         @default(PENDING_PAYMENT)
  amount                     Int
  currency                   String                @default("chf")
  platformFeeAmount          Int
  stripeSessionId            String?
  stripePaymentIntentId      String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  service                    String?
  startDate                  DateTime?
  endDate                    DateTime?
  message                    String?
  canceledAt                 DateTime?
  archivedAt                 DateTime?
  deletedAt                  DateTime?
  refundedAt                 DateTime?
  stripeRefundId             String?
  stripeApplicationFeeAmount Int                   @default(0)
  stripeTransferId           String?
  reviewRequestEmailSentAt   DateTime?
  endAt                      DateTime?
  serviceType                ServiceType?
  startAt                    DateTime?
  stripeChargeId             String?
  stripeProcessingFeeAmount  Int                   @default(0)
  sitterPayoutAmount         Int?
  payoutReleasedAt           DateTime?
  lastMinuteSmsSentAt        DateTime?
  payoutMethod               BookingPayoutMethod   @default(STRIPE)
  payoutStatus               BookingPayoutStatus   @default(PENDING)
  paidAt                     DateTime?
  locationMode               String?
  travelDistanceKm           Float?
  travelFeeAmount            Int?
  ownerLat                   Float?
  ownerLng                   Float?
  ownerAddress               String?
  /// Dog profile selected by the owner at booking time
  dogProfileId               String?
  /// Owner phone number shared with the sitter
  ownerPhone                 String?
  /// Additional dog profile IDs (JSON array of strings) when multiple dogs are booked
  additionalDogProfileIds    String?
  selectedDog                DogProfile?           @relation(fields: [dogProfileId], references: [id])
  sitter                     User                  @relation("SitterBookings", fields: [sitterId], references: [sitterId])
  user                       User                  @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  financeEvents              BookingFinanceEvent[]
  conversations              Conversation[]        @relation("BookingConversations")
  review                     Review?
  serviceReport              ServiceReport?

  @@index([userId])
  @@index([sitterId])
  @@index([dogProfileId])
  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
}

/// A sitter's post-service report to the owner: photos, a structured checklist,
/// a free note, and an optional GPS walk track. One per booking (1:1).
model ServiceReport {
  id             String              @id @default(cuid())
  bookingId      String              @unique
  /// Sitter (User.sitterId) who authored the report.
  sitterId       String
  /// Owner (User.id) — denormalised for cheap owner-side lookups.
  ownerId        String
  status         ServiceReportStatus @default(DRAFT)
  note           String?             @db.Text
  /// Checklist (nullable = not answered).
  peed           Boolean?
  pooed          Boolean?
  drankWater     Boolean?
  ate            Boolean?
  played         Boolean?
  mood           DogMood?
  /// Energy level 1..5.
  energy         Int?
  incidents      String?             @db.Text
  /// Optional GPS walk track: polyline as JSON [[lat,lng], …].
  routeJson      Json?
  distanceMeters Int?
  trackStartedAt DateTime?
  trackEndedAt   DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  booking Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  photos  ServiceReportPhoto[]

  @@index([sitterId, createdAt])
  @@index([ownerId, createdAt])
}

model ServiceReportPhoto {
  id        String    @id @default(cuid())
  reportId  String
  /// R2 object key (report-photos/{sitterId}/{bookingId}/{uuid}.ext).
  r2Key     String
  caption   String?
  /// Where the photo was taken (optional, for the walk timeline).
  lat       Float?
  lng       Float?
  takenAt   DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  report ServiceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model BookingFinanceEvent {
  id                    String               @id @default(cuid())
  bookingId             String
  eventType             String
  message               String
  payoutMethod          BookingPayoutMethod?
  payoutStatus          BookingPayoutStatus?
  amount                Int?
  currency              String?
  stripeChargeId        String?
  stripeTransferId      String?
  stripePaymentIntentId String?
  metadata              Json?
  actorType             FinanceActorType?
  actorId               String?
  createdAt             DateTime             @default(now())
  booking               Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorType, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  ownerId   String
  sitterId  String
  rating    Int
  comment   String?
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  owner     User     @relation("ReviewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sitter    User     @relation("ReviewSitter", fields: [sitterId], references: [sitterId])

  @@index([sitterId, createdAt])
  @@index([ownerId, createdAt])
}

model Availability {
  id          String   @id @default(cuid())
  sitterId    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dateKey     String
  sitter      User     @relation("SitterAvailabilities", fields: [sitterId], references: [sitterId], onDelete: Cascade)

  @@unique([sitterId, dateKey])
  @@index([sitterId, dateKey])
}

model AvailabilityRule {
  id          String             @id @default(cuid())
  sitterId    String
  dayOfWeek   Int
  startMin    Int
  endMin      Int
  status      AvailabilityStatus
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  serviceType ServiceType
  sitter      User               @relation(fields: [sitterId], references: [sitterId], onDelete: Cascade)

  @@index([sitterId, serviceType, dayOfWeek])
  @@index([sitterId, serviceType])
}

model AvailabilityException {
  id          String             @id @default(cuid())
  sitterId    String
  date        DateTime           @db.Date
  startMin    Int
  endMin      Int
  status      AvailabilityStatus
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  serviceType ServiceType
  sitter      User               @relation(fields: [sitterId], references: [sitterId], onDelete: Cascade)

  @@index([sitterId, serviceType, date])
  @@index([sitterId, serviceType])
}

model AvailabilityAuditLog {
  id             String       @id @default(cuid())
  sitterId       String
  actorUserId    String
  action         String
  serviceType    ServiceType?
  dateKey        String?
  payloadSummary Json?
  createdAt      DateTime     @default(now())

  @@index([sitterId, createdAt])
  @@index([sitterId, serviceType, createdAt])
}

model ServiceConfig {
  id                String      @id @default(cuid())
  sitterId          String
  serviceType       ServiceType
  enabled           Boolean     @default(true)
  slotStepMin       Int
  minDurationMin    Int
  maxDurationMin    Int
  leadTimeMin       Int
  bufferBeforeMin   Int
  bufferAfterMin    Int
  overnightRequired Boolean     @default(false)
  checkInStartMin   Int?
  checkInEndMin     Int?
  checkOutStartMin  Int?
  checkOutEndMin    Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastMinuteEnabled Boolean     @default(false)
  sitter            User        @relation(fields: [sitterId], references: [sitterId], onDelete: Cascade)

  @@unique([sitterId, serviceType])
  @@index([sitterId])
  @@index([serviceType])
}

model Conversation {
  id                 String      @id @default(cuid())
  ownerId            String
  sitterId           String
  bookingId          String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  /// Dog selected by the owner as the subject of this conversation.
  dogProfileId       String?
  /// Set when owner pins the conversation; null = not pinned.
  pinnedAt           DateTime?
  /// Set when owner archives the conversation; null = not archived.
  archivedAt         DateTime?
  /// Soft-delete: set when owner deletes the conversation; null = visible.
  deletedAt          DateTime?
  booking            Booking?    @relation("BookingConversations", fields: [bookingId], references: [id])
  selectedDog        DogProfile? @relation(fields: [dogProfileId], references: [id])
  owner              User        @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  sitter             User        @relation("SitterConversations", fields: [sitterId], references: [sitterId])
  messages           Message[]

  @@unique([ownerId, sitterId])
  @@index([ownerId])
  @@index([sitterId])
  @@index([bookingId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Immutable audit trail for legal / dispute purposes.
/// Records every critical action on the platform with actor, target and timestamp.
/// Never delete rows — only append. No PII in metadata (use IDs only).
model AuditLog {
  id         String   @id @default(cuid())
  /// e.g. "booking.created", "booking.paid", "booking.cancelled",
  /// "sitter.approved", "sitter.rejected", "account.deleted"
  action     String
  /// "admin" | "user" | "system" | "stripe"
  actorType  String
  /// Clerk user ID (admin/user), "system" or "stripe"
  actorId    String?
  /// Primary key of the affected entity (booking ID, user ID, etc.)
  targetId   String?
  /// "BOOKING" | "USER" | "SITTER_PROFILE" | "APPLICATION"
  targetType String?
  /// Additional context: amounts (in cents), old/new status, payment intent ID…
  /// Never store email, name, phone or other PII here.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetId, targetType])
  @@index([actorId, createdAt])
}

/// Singleton row `id = "global"` — platform-wide toggles (maintenance, etc.).
model PlatformSettings {
  id                 String   @id
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Persistent memory for autonomous agents (Maestro & sub-agents).
/// Stores conversation history, context, and state between runs.
model AgentMemory {
  id         String   @id @default(cuid())
  /// Agent name: "maestro", "booking_agent", "dispo_agent", "payment_agent"…
  agentName  String
  /// Session ID to group related interactions
  sessionId  String
  /// Role: "system" | "user" | "assistant" | "tool_call" | "tool_result"
  role       String
  /// The actual message content (JSON stringified for complex objects)
  content    String
  /// Token count for context window management
  tokenCount Int      @default(0)
  /// Metadata for filtering (bookingId, sitterId, userId, etc.)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([agentName, sessionId, createdAt])
  @@index([agentName, createdAt])
  @@index([sessionId, createdAt])
}

/// Logs every action taken by an autonomous agent. Append only.
model AgentLog {
  id         String   @id @default(cuid())
  /// "maestro" | "booking_agent" | "dispo_agent" | "payment_agent" | "notification_agent" | "supervision_agent"
  agentName  String
  /// "webhook_received" | "intent_determined" | "sub_agent_called" | "api_call" | "error" | "success"
  actionType String
  /// What the agent did (human readable)
  summary    String
  /// Full details (request, response, error stack…)
  details    Json?
  /// Related entities (booking ID, user ID, sitter ID…)
  targetId   String?
  /// Duration in ms
  durationMs Int?
  /// Status: "success" | "error" | "running"
  status     String   @default("success")
  createdAt  DateTime @default(now())

  @@index([agentName, createdAt])
  @@index([actionType, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Tracks scheduled or running tasks for autonomous agents.
model AgentTask {
  id           String    @id @default(cuid())
  /// "maestro" | "booking_agent" | "dispo_agent" | …
  agentName    String
  /// "scheduled" | "running" | "completed" | "failed" | "cancelled"
  status       String    @default("scheduled")
  /// Human readable task description
  title        String
  /// Full task definition / parameters
  payload      Json?
  /// Result of the task execution
  result       Json?
  /// Error message if failed
  errorMessage String?
  /// How many times it has been retried
  retryCount   Int       @default(0)
  /// Max retries before marking as failed
  maxRetries   Int       @default(3)
  /// When the task should be executed
  scheduledAt  DateTime?
  /// When the task started
  startedAt    DateTime?
  /// When the task completed/failed
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([agentName, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([createdAt])
}

/// Dog profile belonging to an owner. One owner can have multiple dogs.
/// conversations field: conversations where this dog was selected as the subject.
model DogProfile {
  id                 String         @id @default(cuid())
  userId             String
  name               String
  breed              String?
  birthYear          Int?
  weightKg           Float?
  medications        String?
  allergies          String?
  vetContact         String?
  behaviorNotes      String?
  feedingNotes       String?
  isDefault          Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  photoUrl           String?
  sitterInstructions String?
  /// Whether the dog is neutered/spayed — used to validate sitter acceptance criteria
  neutered           Boolean?
  /// Sex of the dog.
  sex                DogSex?
  bookings           Booking[]
  conversations      Conversation[]
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Adoption ("Adopter un chien")
//
// Swiss law drives most of the non-obvious columns here. The load-bearing rules:
//   - OPAn art. 76d al. 1 — a public dog-cession ad MUST carry the cédant's
//     first + last name and address, the dog's provenance and its country of
//     breeding. Al. 2 puts the completeness duty on the PLATFORM, so these are
//     non-nullable columns, not optional profile fields.
//   - OPAn art. 70 al. 4 — a puppy cannot leave its mother before 56 days, so
//     `birthDate` is required and gates publication.
//   - OFE art. 16-18 (AMICUS) — the dog must be chipped before any cession and
//     both parties declare the transfer within 10 days. `microchipNumber` is
//     what we nudge them with.
//   - Cantonal breed bans / permits (GE, VS, ZH, FR, VD) key off `canton` +
//     `breed`; the matrix lives in lib/adoption/breedRestrictions.ts.
//   - Deliberately NO "price": money is a `feeAmount` ("participation aux
//     frais") settled off-platform. DogShift takes no commission — a cut on an
//     animal transaction risks requalifying us as a professional seller
//     (OPAn art. 2 al. 3 let. a) and dragging in CO art. 197 ss warranty.
// ─────────────────────────────────────────────────────────────────────────────

/// A rescue / shelter account. Manually verified by an admin before its badge
/// shows up on listings (anibis/VeriPet-style trust anchor).
model RescueOrganization {
  id           String             @id @default(cuid())
  /// Owner of the org account. One user manages at most one organisation.
  userId       String             @unique
  name         String
  status       RescueOrgStatus    @default(PENDING)
  /// Cantonal authorisation number (OPAn art. 101) when the org holds one.
  cantonalAuthNumber String?
  websiteUrl   String?
  email        String?
  phone        String?
  address      String?
  postalCode   String?
  city         String?
  canton       String?
  logoUrl      String?
  description  String?            @db.Text
  verifiedAt   DateTime?
  verifiedBy   String?
  rejectedReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings AdoptionListing[]

  @@index([status])
}

/// A dog offered for adoption, by a private owner or a verified organisation.
model AdoptionListing {
  id             String                @id @default(cuid())
  /// The cédant's DogShift account.
  userId         String
  /// Set when the listing is published on behalf of a verified organisation.
  organizationId String?
  status         AdoptionListingStatus @default(DRAFT)

  // ── Dog identity ──────────────────────────────────────────────────────────
  dogName        String
  breed          String?
  secondaryBreed String?
  isCrossbreed   Boolean               @default(false)
  sex            DogSex
  /// Required — drives the 56-day rule (OPAn art. 70 al. 4) and the age filter.
  birthDate      DateTime
  sizeCategory   DogSize
  weightKg       Float?
  neutered       Boolean?
  vaccinated     Boolean?
  dewormed       Boolean?

  // ── Legal disclosure (OPAn art. 76d al. 1 + AMICUS) ────────────────────────
  /// AMICUS microchip number. Nullable only so a DRAFT can be saved before it
  /// is known; publication requires it.
  microchipNumber String?
  provenance      DogProvenance
  /// ISO-3166-1 alpha-2 country where the dog was bred (e.g. "CH", "RO").
  breedingCountry String
  cedantFullName   String
  cedantAddress    String
  cedantPostalCode String
  cedantCity       String

  // ── Placement details ──────────────────────────────────────────────────────
  /// "Participation aux frais" in centimes (0 = gratuit). Never a sale price,
  /// never transits DogShift.
  feeAmount        Int      @default(0)
  /// Why the dog is being rehomed — the single most-read field by adopters.
  reason           String?  @db.Text
  description      String   @db.Text
  idealHome        String?  @db.Text
  goodWithChildren Boolean?
  goodWithDogs     Boolean?
  goodWithCats     Boolean?
  houseTrained     Boolean?
  /// 1 (canapé) … 5 (marathonien).
  energyLevel      Int?
  specialNeeds     String?  @db.Text

  // ── Location ───────────────────────────────────────────────────────────────
  /// Two-letter canton code (VD, GE, ZH…). Drives breed restrictions + filters.
  canton   String
  city     String
  lat      Float?
  lng      Float?

  /// Ordered array of R2 object keys (first = cover photo).
  photos   String[]

  publishedAt     DateTime?
  /// Last time the cédant confirmed the dog is still available. Powers the
  /// freshness cron + auto-archive (the #1 complaint about Petfinder).
  lastConfirmedAt DateTime?
  adoptedAt       DateTime?
  archivedAt      DateTime?
  /// Set when the cédant ticks the legal-compliance checkbox at publication.
  acceptedTermsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation("AdoptionListingAuthor", fields: [userId], references: [id], onDelete: Cascade)
  organization RescueOrganization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  applications AdoptionApplication[]

  @@index([status, publishedAt])
  @@index([userId])
  @@index([canton])
  @@index([organizationId])
}

/// Reusable adopter dossier — filled once, attached to every application
/// (PetRescue's killer feature). Pre-fillable from the user's existing
/// DogShift data (dogs, bookings, reviews).
model AdopterProfile {
  id       String @id @default(cuid())
  userId   String @unique

  housingType       HousingType
  /// Renters must confirm the landlord allows dogs.
  isHomeOwner       Boolean
  landlordApproval  Boolean?
  hasGarden         Boolean     @default(false)
  gardenFenced      Boolean?
  householdAdults   Int         @default(1)
  householdChildren Int         @default(0)
  /// Age of the youngest child, when there are children.
  youngestChildAge  Int?
  hasOtherDogs      Boolean     @default(false)
  hasCats           Boolean     @default(false)
  otherPetsNote     String?     @db.Text
  /// Typical hours the dog would be left alone on a weekday.
  hoursAlonePerDay  Int?
  /// Self-declared experience level, 1 (première fois) … 5 (éducateur).
  experienceLevel   Int
  previousDogsNote  String?     @db.Text
  activityLevel     Int?
  canton            String?
  city              String?
  motivation        String?     @db.Text
  /// nLPD — explicit consent to share this dossier with cédants.
  consentSharedAt   DateTime?
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One adopter's candidature on one listing.
model AdoptionApplication {
  id        String                    @id @default(cuid())
  listingId String
  /// The candidate adopter.
  userId    String
  status    AdoptionApplicationStatus @default(PENDING)
  message   String?                   @db.Text
  /// Frozen copy of the adopter dossier at submission time (nLPD: the cédant
  /// sees what was actually sent, later profile edits don't rewrite history).
  answers   Json?

  respondedAt DateTime?
  declineReason String?
  withdrawnAt DateTime?
  /// Set when the cédant confirms this adopter took the dog.
  adoptedAt   DateTime?
  /// AMICUS transfer declaration (10-day deadline) confirmed by both parties.
  amicusConfirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing AdoptionListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User            @relation("AdoptionApplicant", fields: [userId], references: [id], onDelete: Cascade)
  thread  AdoptionThread?

  @@unique([listingId, userId])
  @@index([listingId, status])
  @@index([userId])
}

/// Cédant ↔ adopter chat scoped to one application. The existing Conversation
/// model is owner↔sitter only and cannot be reused.
model AdoptionThread {
  id                 String    @id @default(cuid())
  applicationId      String    @unique
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  application AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages    AdoptionMessage[]

  @@index([lastMessageAt])
}

model AdoptionMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread AdoptionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User           @relation("AdoptionMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

/// A saved adoption search that fires a push/email alert when a new listing
/// matches. The one feature every shelter platform users ask for.
model AdoptionSavedSearch {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  /// Serialized filter state (cantons, sizes, ages, compatibilities…).
  filters    Json
  alertsOn   Boolean  @default(true)
  /// Watermark so the cron only notifies about listings newer than this.
  lastNotifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alertsOn])
}

model LeadMagnet {
  id              String    @id @default(cuid())
  email           String    @unique
  source          String    @default("homepage_banner")
  capturedAt      DateTime  @default(now())
  prenom          String?
  nurturingStep   Int       @default(0)
  lastNurturingAt DateTime?
  unsubscribed    Boolean   @default(false)

  @@index([nurturingStep, capturedAt])
  @@index([nurturingStep, lastNurturingAt])
}

model ScheduledEmail {
  id        String    @id @default(cuid())
  userId    String
  email     String
  type      String
  sendAfter DateTime
  sent      Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sent, sendAfter])
}

model AgentConfig {
  id           String   @id @default(cuid())
  slug         String   @unique
  label        String
  description  String
  active       Boolean  @default(true)
  cronSchedule String?
  parameters   Json     @default("{}")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Native push tokens for iOS (APNs) and Android (FCM), used by the Capacitor app.
/// Distinct from PushSubscription (which is the web push / VAPID registration).
model NativePushToken {
  id            String             @id @default(cuid())
  userId        String
  /// "ios" for APNs, "android" for FCM
  platform      NativePushPlatform
  /// APNs device token (hex string) or FCM registration token
  token         String             @unique
  /// Bundle identifier (helps with multi-env: dev/staging/prod APNs sandbox)
  bundleId      String?
  /// Helps identify dead/invalid tokens after 410 Gone / NotRegistered errors
  invalidatedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@map("native_push_tokens")
}

enum NativePushPlatform {
  ios
  android
}

/// Append-only audit of every transactional email the platform sends.
/// Populated by `lib/email/sendEmail.ts` on every call (success OR failure),
/// so the admin can answer "did Sonia really receive a suspension warning
/// on Tuesday at 3pm?" without grepping Vercel logs or Resend's dashboard.
///
/// PII rules : `to` and `subject` are stored verbatim (we need them to
/// search). `metadata` MUST stay PII-free — IDs only.
model EmailLog {
  id           String   @id @default(cuid())
  to           String
  fromAddress  String?
  subject      String
  /// Logical template name set by the caller, e.g. "inactivity-warning-1",
  /// "reset-password", "booking-confirmed". Optional but strongly preferred —
  /// it's what makes the admin page filterable.
  templateName String?
  /// Where the email was triggered from, e.g. "cron:inactivity-check",
  /// "api:auth/forgot-password", "agent:relance-owners". Free text but
  /// kebab-case prefix convention.
  context      String?
  /// "sent" when the provider returned 2xx, "failed" on any throw, "skipped"
  /// when the caller pre-emptively decided not to send (rare).
  status       String
  /// Provider used: "resend" | "smtp" | "log" (dev fallback).
  mode         String?
  /// Provider-assigned message id (Resend). Useful for cross-checking with
  /// the Resend dashboard or bounce webhooks.
  messageId    String?
  /// When status=failed, the error message. Truncated at 500 chars.
  errorMessage String?
  /// FK-like reference to User.id when the recipient is a known account.
  /// Not a hard FK to keep this table writable even if the user is later
  /// deleted (audit must survive deletions).
  targetUserId String?
  /// Small, PII-free extra context. e.g. { bookingId, sitterId, stage }.
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([to, createdAt])
  @@index([templateName, createdAt])
  @@index([status, createdAt])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

